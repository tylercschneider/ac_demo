
# Acceptance runner artifact
/acceptance-result.json

# Ignore key files for decrypting credentials and more.
/config/*.key


# Never commit these
/config/master.key
/storage/*.sqlite3
/storage/*.sqlite3-*

# Logs and temporary files, as a new Rails app ignores them
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
